# Copie para .env e ajuste o caminho do projeto (obrigatório no Windows se o projeto não estiver em C:)
# Ex.: projeto em D:\Yugioh -> PROJECT_PATH=D:/Yugioh
PROJECT_PATH=D:/Yugioh

# Supabase DATABASE_URL (pooler): o backend converte automaticamente porta 5432 → 6543 (Transaction / PgBouncer),
# evitando "MaxClientsInSessionMode: max clients reached - pool_size".
# Só use Session pooler (5432) se precisar: SUPABASE_TRANSACTION_POOLER=false
# Opcional: DATABASE_POOL_MAX=8 (padrão ~8 com 6543, ~4 se ficar na 5432).
# DATABASE_URL=postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:6543/postgres?pgbouncer=true

# Com banco Supabase: no backend (local e produção) defina SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY
# para que imagens de cartas sejam salvas no Storage e o salvamento seja igual no local e em produção.

# Para ambiente LOCAL = PRODUÇÃO (testar build e config iguais ao deploy):
# copie .env.staging.example para .env e use: docker compose -f docker-compose.staging.yml up --build
# Veja AMBIENTE-LOCAL-PRODUCAO.md