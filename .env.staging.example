# ============================================================
# Ambiente LOCAL igual a PRODUÇÃO (staging)
# ============================================================
# Copie para .env e use com: docker compose -f docker-compose.staging.yml up --build
#
# No Windows, se o projeto não estiver em C:, defina PROJECT_PATH
# Ex.: projeto em D:\Yugioh -> PROJECT_PATH=D:/Yugioh
# ============================================================

PROJECT_PATH=D:/Yugioh

# ---------- Banco (mesmos nomes que produção; valores podem ser de teste)
POSTGRES_USER=yugioh_user
POSTGRES_PASSWORD=yugioh_password_2024
POSTGRES_DB=yugioh_db

MONGO_USER=yugioh_mongo
MONGO_PASSWORD=yugioh_mongo_password

# ---------- Backend (NODE_ENV=production no compose)
JWT_SECRET=yugioh_staging_secret_troque_em_producao
CORS_ORIGIN=http://localhost,http://localhost:80

# ---------- Frontend (usado no build; para staging local use localhost)
# Se você acessar só por http://localhost (nginx), pode deixar em branco ou http://localhost
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000

# ---------- Opcionais (igual ao backend/.env.example)
# EMAIL_USER=
# EMAIL_PASSWORD=
# FRONTEND_URL=http://localhost
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
