# API do backend (usado para requisições HTTP e fallback do WebSocket).
# Em produção: use um domínio próprio (ex: https://api.seudominio.com) para que
# o Network do navegador não mostre a URL do Fly.io. No Fly, adicione um custom
# domain no app do backend e aponte esta variável para ele.
VITE_API_URL=http://localhost:3000
# WebSocket (em produção use wss://seu-dominio.com ou deixe em branco para same-origin)
VITE_WS_URL=ws://localhost:3000
