# Dockerfile de desenvolvimento: roda Vite dev server (porta 5173)
FROM node:20-alpine

WORKDIR /app

# Copiar dependências
COPY package*.json ./

# Instalar dependências (incluindo devDependencies para Vite)
RUN npm install

# Cópia do código é feita via volume no docker-compose
COPY . .

EXPOSE 5173

# Em docker-compose o comando costuma ser sobrescrito para rodar npm install antes do dev (node_modules em volume).
CMD ["sh", "-c", "npm install && npm run dev -- --host 0.0.0.0"]
