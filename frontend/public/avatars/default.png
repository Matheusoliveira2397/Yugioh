<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 200 200">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#8b5cf6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#6366f1;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="200" height="200" fill="url(#grad1)"/>
  
  <!-- Millennium Puzzle -->
  <g transform="translate(100, 100)">
    <!-- Top triangle -->
    <polygon points="0,-50 -40,-10 40,-10" fill="#fbbf24" stroke="#d97706" stroke-width="2"/>
    
    <!-- Middle triangles -->
    <polygon points="-40,-10 -60,20 -20,20" fill="#fbbf24" stroke="#d97706" stroke-width="2"/>
    <polygon points="40,-10 60,20 20,20" fill="#fbbf24" stroke="#d97706" stroke-width="2"/>
    
    <!-- Bottom triangles -->
    <polygon points="-20,20 -30,50 -10,50" fill="#fbbf24" stroke="#d97706" stroke-width="2"/>
    <polygon points="20,20 30,50 10,50" fill="#fbbf24" stroke="#d97706" stroke-width="2"/>
    
    <!-- Center triangle -->
    <polygon points="0,-10 -20,20 20,20" fill="#f59e0b" stroke="#d97706" stroke-width="2"/>
    
    <!-- Eye -->
    <circle cx="0" cy="5" r="8" fill="#1e293b"/>
    <polygon points="0,-3 -4,8 4,8" fill="#fbbf24"/>
  </g>
  
  <!-- Text -->
  <text x="100" y="190" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="white" text-anchor="middle">
    DUELISTA
  </text>
</svg>
