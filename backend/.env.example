# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://yugioh_user:yugioh_password_2024@localhost:5432/yugioh_db

# MongoDB
MONGODB_URI=mongodb://yugioh_mongo:yugioh_mongo_password@localhost:27017/yugioh_chat?authSource=admin

# Redis (opcional; em produção com múltiplas instâncias, defina para compartilhar salas Socket.IO)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=yugioh_super_secret_key_2024_change_in_production
JWT_EXPIRES_IN=7d

# CORS (em produção use a URL do frontend, ex: https://seusite.com ou várias separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Email – envio para o endereço que a pessoa cadastrar (use Senha de App do Gmail)
# https://myaccount.google.com/apppasswords
EMAIL_USER=seu-email-do-jogo@gmail.com
EMAIL_PASSWORD=sua_senha_de_app_16_caracteres
FRONTEND_URL=http://localhost:5173

# Supabase Storage (obrigatório quando DATABASE_URL for Supabase – senão as imagens de cartas ficam só no disco e não aparecem em produção)
# Defina no LOCAL e em PRODUÇÃO para o salvamento de cartas ser igual nos dois: imagens vão para o Storage e aparecem em todo lugar.
# Obtenha em: Supabase Dashboard > Project Settings > API. Bucket "cards" deve ser público.
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
