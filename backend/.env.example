# Application
NODE_ENV=development
PORT=3000

# Em produção a documentação Swagger (/api/docs) fica desligada por padrão.
# Para staging ou debug interno: ENABLE_SWAGGER=true
# ENABLE_SWAGGER=false

# Database
DATABASE_URL=postgresql://yugioh_user:yugioh_password_2024@localhost:5432/yugioh_db

# Supabase pooler: se "MaxClientsInSessionMode", use Transaction mode sem mudar a URI manualmente:
# SUPABASE_TRANSACTION_POOLER=true
# Ou limite o pool (opcional): DATABASE_POOL_MAX=3
# Renomear imagens no boot (padrão: desligado — use POST /cards/admin/rename-all-images)
# AUTO_RENAME_CARD_IMAGES_ON_BOOT=true
# Tamanho do lote para rename-all-images (evita SELECT enorme / queda de conexão)
# RENAME_CARD_IMAGES_BATCH_SIZE=250

# Pasta de uploads (opcional; no Docker costuma ser /app/uploads detectado automaticamente)
# UPLOADS_ROOT=D:/Yugioh/backend/uploads

# MongoDB
MONGODB_URI=mongodb://yugioh_mongo:yugioh_mongo_password@localhost:27017/yugioh_chat?authSource=admin

# Redis (opcional; em produção com múltiplas instâncias, defina para compartilhar salas Socket.IO)
REDIS_URL=redis://localhost:6379

# JWT (obrigatório em produção; sem aspas; evite espaço/newline no final — o backend faz trim)
JWT_SECRET=yugioh_super_secret_key_2024_change_in_production
JWT_EXPIRES_IN=7d

# CORS (em produção use a URL do frontend, ex: https://seusite.com ou várias separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Email – envio transacional (cadastro, senha, troca de email)
# FRONTEND_URL = base dos links nos emails (verify, reset, etc.) e do redirect OAuth Google
FRONTEND_URL=http://localhost:5173

# --- Login / cadastro com Google (OAuth 2.0) ---
# 1) Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# 2) Authorized JavaScript origins: http://localhost:5173 (e a URL do frontend em produção)
# 3) Authorized redirect URIs: http://localhost:3000/auth/google/callback
#    (deve ser EXATAMENTE igual a GOOGLE_CALLBACK_URL)
# Sem estas variáveis o botão Google fica oculto no frontend.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- Opção A: Gmail (volume limitado ~500/dia). Sem SMTP_HOST o backend usa smtp.gmail.com
# https://myaccount.google.com/apppasswords
EMAIL_USER=seu-email-do-jogo@gmail.com
EMAIL_PASSWORD=sua_senha_de_app_16_caracteres

# --- Opção B: SMTP transacional (recomendado em produção: Resend, SendGrid, SES, Mailgun…)
# Com SMTP_HOST definido, host/porta vêm daqui; auth costuma ser SMTP_USER + SMTP_PASS.
# MAIL_FROM = remetente verificado no provedor (domínio com SPF/DKIM). Pode ser só o email ou "Nome <email@dominio.com>"
#
# Exemplo Resend: https://resend.com/docs/send-with-smtp
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxx
# MAIL_FROM=noreply@seudominio.com
#
# Exemplo SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxx
# MAIL_FROM=noreply@seudominio.com
#
# Só se o servidor SMTP usar certificado inválido (não recomendado):
# SMTP_TLS_INSECURE=true

# Supabase Storage (obrigatório quando DATABASE_URL for Supabase – senão uploads ficam só no disco e não aparecem em produção: cartas, avatares, grupos, cosméticos, conquistas)
# Defina no LOCAL e em PRODUÇÃO para o comportamento ser igual: arquivos vão para o Storage.
# Obtenha em: Supabase Dashboard > Project Settings > API. Bucket "cards" deve ser público.
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- IA dos bots (OpenAI-compatible) ---
# Com BOT_AI_API_KEY (ou OPENAI_API_KEY), o bot usa LLM para escolher magias/traps/efeitos/ataques.
# Sem chave: heurística + memória local em uploads/bot-ai-memory.json
# BOT_AI_ENABLED=true
# BOT_AI_API_KEY=sk-...
# BOT_AI_BASE_URL=https://api.openai.com/v1
# BOT_AI_MODEL=gpt-4o-mini

